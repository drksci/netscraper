  "routes": {
    "tiktok.video": {
      "description": "One record per Explore feed video (from the page's item_list XHRs), capped at maxItems.",
      "key": "id",
      "from": {
        "view": "explore",
        "on": "item",
        "each": "videos[[0..($surfaces.control.run.maxItems - 1)]]"
      },
      "extract": "$item",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "createTime": {
            "type": "number"
          },
          "authorMeta": {
            "type": "object"
          },
          "playCount": {
            "type": "number"
          },
          "diggCount": {
            "type": "number"
          },
          "commentCount": {
            "type": "number"
          },
          "shareCount": {
            "type": "number"
          },
          "cover": {
            "type": "string"
          },
          "webVideoUrl": {
            "type": "string"
          },
          "hashtags": {
            "type": "array"
          }
        }
      }
    }
  },
  "control": {
    "dataModel": {
      "inputs": {
        "maxItems": 100
      }
    },
    "components": [
      {
        "id": "root",
        "component": "Column",
        "children": [
          "form_title",
          "max_slider",
          "start_button"
        ]
      },
      {
        "id": "form_title",
        "component": "Text",
        "text": "TikTok Explore feed",
        "variant": "h3"
      },
      {
        "id": "max_slider",
        "component": "Slider",
        "label": "Videos to collect",
        "min": 10,
        "max": 500,
        "value": {
          "path": "/inputs/maxItems"
        }
      },
      {
        "id": "start_button",
        "component": "Button",
        "child": "start_label",
        "action": {
          "event": {
            "name": "start",
            "context": {
              "maxItems": {
                "path": "/inputs/maxItems"
              }
            }
          }
        }
      },
      {
        "id": "start_label",
        "component": "Text",
        "text": "Start"
      }
    ]
  },
  "policies": {
    "timeouts": {
      "navigate": 45000,
      "await": 25000,
      "action": 20000,
      "input": 10000
    },
    "retry": {
      "attempts": 3,
      "baseMs": 800,
      "maxMs": 8000,
      "jitter": 0.3
    },
    "rateLimit": {
      "minDelayMs": 400,
      "jitterMs": 600
    },
    "dismiss": [
      {
        "sel": "[data-e2e=\"modal-close-inner-button\"]",
        "intent": "Close the login prompt"
      }
    ],
    "blocked": {
      "selectors": [
        "#captcha-verify-container",
        "[id*=\"captcha_container\"]",
        "iframe[src*=\"captcha\"]"
      ],
      "textPatterns": [
        "verify to continue",
        "drag the slider"
      ],
      "action": "fail"
    },
    "http": {
      "retry": [
        408,
        425,
        429,
        500,
        502,
        503,
        504
      ],
      "fatal": [
        401,
        403,
        404,
        410
      ]
    }
  },
  "machine": {
    "id": "tiktok.explore",
    "initial": "idle",
    "context": {
      "maxItems": 100,
      "stall": 0
    },
    "on": {
      "INTERRUPT": {
        "target": ".interrupted"
      }
    },
    "states": {
      "interrupted": {
        "entry": [
          {
            "type": "log",
            "params": {
              "text": "interrupt: {{ event.view }}"
            }
          }
        ],
        "invoke": {
          "src": "a2ui.act",
          "input": {
            "on": "dismiss"
          },
          "onDone": {
            "target": "resume"
          },
          "onError": {
            "target": "resume"
          }
        }
      },
      "resume": {
        "type": "history",
        "history": "deep"
      },
      "idle": {
        "on": {
          "start": {
            "target": "open",
            "actions": [
              {
                "type": "ctx.set",
                "params": {
                  "maxItems": "{{ event.context.maxItems | int }}"
                }
              },
              {
                "type": "a2ui.write",
                "params": {
                  "path": "/run",
                  "value": {
                    "maxItems": "{{ event.context.maxItems | int }}"
                  }
                }
              },
              {
                "type": "work.start",
                "params": {
                  "type": "feed",
                  "key": "explore"
                }
              }
            ]
          }
        }
      },
      "open": {
        "invoke": {
          "src": "browser.navigate",
          "input": {
            "url": "/explore"
          },
          "onDone": "awaitFeed",
          "onError": "failed"
        }
      },
      "awaitFeed": {
        "invoke": {
          "src": "view.await",
          "input": {
            "views": [
              "explore",
              "captcha",
              "blocked"
            ]
          },
          "onError": "failed",
          "onDone": [
            {
              "guard": {
                "type": "cond",
                "params": {
                  "eq": [
                    "{{ event.output.view }}",
                    "captcha"
                  ]
                }
              },
              "target": "failed",
              "actions": [
                {
                  "type": "log",
                  "params": {
                    "text": "captcha shown — not solving; stopping"
                  }
                }
              ]
            },
            {
              "guard": {
                "type": "cond",
                "params": {
                  "eq": [
                    "{{ event.output.view }}",
                    "blocked"
                  ]
                }
              },
              "target": "failed",
              "actions": [
                {
                  "type": "log",
                  "params": {
                    "text": "feed blocked"
                  }
                }
              ]
            },
            {
              "target": "loadFeed"
            }
          ]
        }
      },
      "loadFeed": {
        "always": [
          {
            "guard": {
              "type": "cond",
              "params": {
                "or": [
                  {
                    "gte": [
                      {
                        "count": "/videos"
                      },
                      "{{ maxItems }}"
                    ]
                  },
                  {
                    "stalled": 3
                  }
                ]
              }
            },
            "target": "emit"
          },
          {
            "target": "loadingMore"
          }
        ]
      },
      "loadingMore": {
        "invoke": {
          "src": "a2ui.act",
          "input": {
            "on": "load_more",
            "action": "loadMore"
          },
          "onError": {
            "target": "emit",
            "actions": [
              {
                "type": "log",
                "params": {
                  "text": "loadMore gave up; emitting what we have"
                }
              }
            ]
          },
          "onDone": {
            "target": "loadFeed",
            "actions": [
              {
                "type": "ctx.stall",
                "params": {
                  "count": {
                    "$count": "/videos"
                  }
                }
              }
            ]
          }
        }
      },
      "emit": {
        "entry": [
          {
            "type": "route.emit",
            "params": {
              "route": "tiktok.video"
            }
          },
          {
            "type": "work.complete",
            "params": {
              "type": "feed",
              "key": "explore"
            }
          }
        ],
        "always": {
          "target": "done"
        }
      },
      "failed": {
        "entry": [
          {
            "type": "work.fail",
            "params": {
              "type": "feed",
              "key": "explore",
              "error": "{{ event.error.message }}"
            }
          }
        ],
        "always": {
          "target": "done"
        }
      },
      "done": {
        "type": "final"
      }
    }
  }
}
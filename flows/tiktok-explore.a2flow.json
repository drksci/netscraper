{
  "a2flow": "0.2",
  "id": "tiktok.explore",
  "title": "TikTok Explore feed videos",
  "description": "Scrolls tiktok.com/explore like a visitor and reads videos from the page's own /api/explore/item_list/ XHRs.",
  "a2ui": {
    "version": "v0.9",
    "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
    "theme": {
      "primaryColor": "#FE2C55",
      "agentDisplayName": "TikTok · a2flow"
    }
  },
  "target": {
    "baseUrl": "https://www.tiktok.com",
    "viewport": {
      "width": 1280,
      "height": 900
    },
    "browser": {
      "humanize": true,
      "headless": true
    }
  },
  "inputs": {
    "type": "object",
    "required": [
      "maxItems"
    ],
    "properties": {
      "maxItems": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "default": 100,
        "description": "How many feed videos to collect"
      }
    }
  },
  "views": {
    "captcha": {
      "title": "Captcha",
      "outcome": true,
      "match": {
        "selector": "#captcha-verify-container, [id*=\"captcha_container\"], iframe[src*=\"captcha\"]"
      },
      "components": [
        {
          "id": "root",
          "component": "Text",
          "text": "Captcha shown — run paused"
        }
      ],
      "model": {},
      "anchors": {},
      "actions": {}
    },
    "blocked": {
      "title": "Feed failed to load",
      "outcome": true,
      "match": {
        "path": "^/explore/?$",
        "text": "Something went wrong|Too many attempts|Try again later"
      },
      "components": [
        {
          "id": "root",
          "component": "Text",
          "text": "Feed blocked / failed to load"
        }
      ],
      "model": {},
      "anchors": {},
      "actions": {}
    },
    "loginModal": {
      "title": "Login prompt",
      "interrupt": true,
      "match": {
        "selector": "#loginModalContentContainer"
      },
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": [
            "login_title",
            "dismiss"
          ]
        },
        {
          "id": "login_title",
          "component": "Text",
          "text": "Log in to TikTok (prompt)",
          "variant": "h4"
        },
        {
          "id": "dismiss",
          "component": "Button",
          "child": "dismiss_label",
          "action": {
            "event": {
              "name": "dismiss"
            }
          }
        },
        {
          "id": "dismiss_label",
          "component": "Text",
          "text": "Close"
        }
      ],
      "model": {},
      "anchors": {
        "dismiss": {
          "sel": "[data-e2e=\"modal-close-inner-button\"]"
        }
      },
      "actions": {
        "dismiss": {
          "op": "click",
          "anchor": "dismiss",
          "intent": "Close the login prompt with its X button"
        }
      }
    },
    "explore": {
      "title": "TikTok Explore",
      "match": {
        "path": "^/explore/?$",
        "selector": "#explore-item-list"
      },
      "model": {
        "/explore": {
          "fields": {
            "topRightContainer": {
              "each": "div[class*=\"-DivTopRightContainer\"]",
              "fields": {
                "text": {
                  "get": "text"
                }
              }
            },
            "categoryList": {
              "each": "div[class*=\"-DivCategoryList\"]",
              "fields": {
                "text": {
                  "get": "text"
                }
              }
            },
            "loginButtonContainer": {
              "sel": "div[class*=\"-LoginButtonContainer\"]",
              "get": "text"
            },
            "text": {
              "each": "div.TUXButton-content",
              "fields": {
                "text": {
                  "get": "text"
                }
              }
            },
            "text2": {
              "each": "div.TUXButton-label",
              "fields": {
                "text": {
                  "get": "text"
                }
              }
            },
            "exploreCategoryChip": {
              "sel": "#category-list-container > div[class*=\"-DivCategoryList\"] > div[data-e2e=\"explore-category-chip\"] > div[data-testid=\"tux-web-interaction-container\"] > button > div[data-testid=\"tux-web-text\"]",
              "get": "text"
            }
          }
        },
        "/videos": {
          "net": {
            "url": "/api/explore/item_list/",
            "method": "GET",
            "when": "$exists(itemList)",
            "key": "id",
            "mode": "append",
            "select": "itemList.{\"id\": id, \"text\": desc, \"createTime\": createTime, \"authorMeta\": {\"id\": author.id, \"name\": author.uniqueId, \"nickName\": author.nickname, \"verified\": author.verified}, \"playCount\": stats.playCount, \"diggCount\": stats.diggCount, \"commentCount\": stats.commentCount, \"shareCount\": stats.shareCount, \"cover\": video.cover, \"webVideoUrl\": \"https://www.tiktok.com/@\" & author.uniqueId & \"/video/\" & id, \"hashtags\": [challenges.title]}"
          }
        },
        "/tiles": {
          "each": "#explore-item-list > div",
          "fields": {
            "url": {
              "sel": "a[href*=\"/video/\"]",
              "get": "attr:href",
              "as": "url"
            },
            "id": {
              "sel": "a[href*=\"/video/\"]",
              "get": "attr:href",
              "re": "(\\d{6,})"
            },
            "likes": {
              "sel": "div[data-e2e=\"explore-card-like-container\"] > span",
              "get": "text",
              "as": "count"
            },
            "author": {
              "sel": "p[data-e2e=\"explore-card-user-unique-id\"]",
              "get": "text"
            }
          }
        }
      },
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": [
            "title",
            "video_list",
            "load_more"
          ]
        },
        {
          "id": "title",
          "component": "Text",
          "text": "Explore feed",
          "variant": "h3"
        },
        {
          "id": "video_list",
          "component": "List",
          "children": {
            "path": "/videos",
            "componentId": "video_card"
          }
        },
        {
          "id": "video_card",
          "component": "Card",
          "child": "video_row"
        },
        {
          "id": "video_row",
          "component": "Row",
          "children": [
            "video_cover",
            "video_info"
          ]
        },
        {
          "id": "video_cover",
          "component": "Image",
          "url": {
            "path": "cover"
          },
          "fit": "cover"
        },
        {
          "id": "video_info",
          "component": "Column",
          "children": [
            "video_text",
            "video_author",
            "video_plays"
          ]
        },
        {
          "id": "video_text",
          "component": "Text",
          "text": {
            "path": "text"
          }
        },
        {
          "id": "video_author",
          "component": "Text",
          "text": {
            "path": "authorMeta/name"
          },
          "variant": "caption"
        },
        {
          "id": "video_plays",
          "component": "Text",
          "text": {
            "call": "formatNumber",
            "args": {
              "value": {
                "path": "playCount"
              }
            },
            "returnType": "string"
          },
          "variant": "caption"
        },
        {
          "id": "load_more",
          "component": "Button",
          "child": "load_more_label",
          "action": {
            "event": {
              "name": "loadMore"
            }
          }
        },
        {
          "id": "load_more_label",
          "component": "Text",
          "text": "Load more"
        }
      ],
      "anchors": {
        "video_list": {
          "model": "/tiles"
        },
        "load_more": {
          "model": "/tiles"
        }
      },
      "actions": {
        "loadMore": {
          "op": "scroll",
          "by": "page",
          "intent": "Scroll the explore grid down so more videos load"
        }
      },
      "settle": {
        "quietMs": 300,
        "timeoutMs": 30000
      },
      "fingerprint": {
        "simhash": "8901c617",
        "shape": [
